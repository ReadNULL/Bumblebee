{
  "name": "bumblebee",
  "version": "2.0.0-alpha.0",
  "description": "A value-focused agent extension for pi, rebuilt from foundational components.",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "pi-package",
    "coding-agent",
    "agent"
  ],
  "files": [
    "src/extension.ts",
    "src/foundation/index.ts",
    "src/foundation/cancellation/abort.ts",
    "src/foundation/cancellation/duration.ts",
    "src/foundation/cancellation/index.ts",
    "src/foundation/cancellation/sleep.ts",
    "src/foundation/cancellation/with-timeout.ts",
    "src/foundation/concurrency/fifo-queue.ts",
    "src/foundation/concurrency/index.ts",
    "src/foundation/concurrency/keyed-serial-queue.ts",
    "src/foundation/concurrency/semaphore.ts",
    "src/foundation/concurrency/types.ts",
    "src/foundation/errors/bumblebee-error.ts",
    "src/foundation/errors/index.ts",
    "src/foundation/logging/index.ts",
    "src/foundation/logging/sanitizer.ts",
    "src/foundation/logging/structured-logger.ts",
    "src/foundation/logging/trace-context.ts",
    "src/foundation/logging/types.ts",
    "src/foundation/lifecycle/cleanup-stack.ts",
    "src/foundation/lifecycle/index.ts",
    "src/foundation/lifecycle/lifecycle.ts",
    "src/foundation/lifecycle/types.ts",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "pi": {
    "extensions": [
      "./src/extension.ts"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "0.78.1",
    "@types/node": "22.19.20",
    "typescript": "5.9.3",
    "vitest": "2.1.9"
  },
  "engines": {
    "node": ">=22.19.0"
  }
}
