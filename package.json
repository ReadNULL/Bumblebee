  "keywords": [
    "coding-agent",
    "ai",
    "llm",
    "cli",
    "tui",
    "agent",
    "wechat",
    "feishu",
    "dingtalk"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@earendil-works/pi-coding-agent": "^0.78.0",
    "@larksuiteoapi/node-sdk": "^1.36.0",
    "qrcode": "^1.5.4",
    "typebox": "^1.1.0",
    "wechaty": "^1.20.2",
    "yaml": "^2.5.0",
    "zod": "^3.23.0"
  },
  "optionalDependencies": {
    "wechaty-puppet-padlocal": "^1.20.1"
  },
  "peerDependencies": {
    "@earendil-works/pi-tui": "^0.78.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/qrcode": "^1.5.6",
    "tsup": "^8.2.0",
