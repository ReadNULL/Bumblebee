  "description": "Bumblebee - 全渠道智能编程副官，基于 pi 框架的 AI Coding Agent",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "bumblebee": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsup",
